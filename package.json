{
  "name": "slojka-monorepo",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Slojka (Слойка) — AI-first графический редактор",
  "license": "GPL-3.0-only",
  "author": "Black Triangle",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelpFreedom/slojka.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @slojka/app",
    "build": "npm run build -w @slojka/app",
    "smoke": "npm run smoke -w @slojka/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit": "npm audit --workspaces --include-workspace-root",
    "dist": "npm run bundle -w @slojka/mcp-server && npm run dist -w @slojka/app"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "@imgly/background-removal": {
      ".": "1.4.5",
      "zod": "^3.23.8",
      "lodash": "^4.18.1",
      "onnxruntime-web": "1.17.0"
    }
  }
}
